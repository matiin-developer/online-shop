            "_title": "استایل و انیمیشن‌ها (CSS)",
            "html": "<style>\n/* ===== Pardis Import Header – dynamic effects (editable) ===== */\n.pi-header{--pi-red:#B11A3B;--pi-red2:#7E1029;--pi-slate:#3E4753;transition:all .35s ease;}\n.pi-header .pi-topbar{max-height:60px;overflow:hidden;transition:max-height .4s ease,padding .4s ease,opacity .3s ease;}\n.pi-header.elementor-sticky--effects .pi-topbar{max-height:0;padding-top:0!important;padding-bottom:0!important;opacity:0;}\n.pi-header .pi-main{position:relative;transition:all .35s ease;}\n.pi-header.elementor-sticky--effects .pi-main{background:rgba(255,255,255,.88)!important;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:0 12px 35px rgba(43,50,60,.14);padding-top:6px!important;padding-bottom:6px!important;}\n.pi-header .pi-main::after{content:\"\";position:absolute;inset:auto 0 0 0;height:3px;background:linear-gradient(90deg,var(--pi-red),var(--pi-slate),var(--pi-red));background-size:200% 100%;animation:piLine 6s linear infinite;}\n@keyframes piLine{to{background-position:200% 0}}\n.pi-header .pi-logo img{transition:max-width .35s ease,transform .35s ease;}\n.pi-header .pi-logo:hover img{transform:rotate(-3deg) scale(1.04);}\n.pi-header.elementor-sticky--effects .pi-logo img{max-width:118px!important;}\n.pi-header .pi-nav .elementor-nav-menu--main .elementor-item{transition:color .25s ease;}\n.pi-header .pi-nav .elementor-nav-menu--dropdown{border-top:3px solid var(--pi-red);}\n.pi-header .pi-cta .elementor-button{position:relative;overflow:hidden;animation:piPulse 2.6s infinite;}\n.pi-header .pi-cta .elementor-button::before{content:\"\";position:absolute;top:0;right:-75%;width:50%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);transform:skewX(-25deg);animation:piShine 3.2s ease-in-out infinite;}\n@keyframes piPulse{0%{box-shadow:0 0 0 0 rgba(177,26,59,.45)}70%{box-shadow:0 0 0 14px rgba(177,26,59,0)}100%{box-shadow:0 0 0 0 rgba(177,26,59,0)}}\n@keyframes piShine{0%,60%{right:-75%}100%{right:130%}}\n.pi-header .pi-call .elementor-icon-box-icon .elementor-icon{animation:piRing 2.8s ease-in-out infinite;}\n@keyframes piRing{0%,80%,100%{transform:rotate(0)}84%{transform:rotate(-14deg)}88%{transform:rotate(12deg)}92%{transform:rotate(-8deg)}96%{transform:rotate(5deg)}}\n.pi-header .pi-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#2ecc71;margin-left:6px;box-shadow:0 0 0 0 rgba(46,204,113,.6);animation:piLive 1.8s infinite;vertical-align:middle;}\n@keyframes piLive{70%{box-shadow:0 0 0 8px rgba(46,204,113,0)}100%{box-shadow:0 0 0 0 rgba(46,204,113,0)}}\n@media (prefers-reduced-motion:reduce){.pi-header *{animation:none!important;transition:none!important;}}\n</style>",
