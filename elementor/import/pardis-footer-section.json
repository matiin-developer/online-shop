q.matches ? 0 : -1;\n        l.toggleAttribute('inert', !open); }\n      function toggle(){ if (!mq.matches) return; c.classList.toggle('is-open'); sync(); }\n      t.addEventListener('click', toggle);\n      t.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });\n      (mq.addEventListener ? mq.addEventListener('change', sync) : mq.addListener(sync)); sync();\n    });\n  });\n})();\n</script>\n"},"elements":[],"isInner":false}],"isInner":false}],"page_settings":[],"version":"0.4","title":"\u0641\u0648\u062a\u0631 \u0628\u0627\u0632\u0631\u06af\u0627\u0646\u06cc \u067e\u0631\u062f\u06cc\u0633","type":"section"}