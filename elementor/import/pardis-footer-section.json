t;}\n.pi-footer .pi-f-top,.pi-footer .pi-f-bottom,.pi-footer .pi-f-copy,.pi-footer .pi-f-links,.pi-footer .pi-f-actions,.pi-footer .pi-f-brand-head,.pi-footer .pi-f-copy-end,.pi-footer .pi-f-cta{flex-direction:row!important;flex-wrap:nowrap!important;}\n.pi-footer .pi-f-card>.elementor-element,.pi-footer .pi-f-col>.elementor-element,.pi-footer .pi-f-brand>.elementor-element,.pi-footer .pi-f-contactcol>.elementor-element,.pi-footer .pi-f-btns>.elementor-element{width:100%!important;max-width:100%!important;flex:0 0 auto!important;}\n.pi-footer .pi-f-brand-head>.elementor-element,.pi-footer .pi-f-copy-end>.elementor-element{flex:0 0 auto!important;width:auto!important;margin:0!important;}\n\n/* --- \u06af\u0648\u0634\u0647 \u0628\u0631\u06cc\u062f\u0647 \u0628\u0627 \u0642\u0648\u0633 \u0645\u0639\u06a9\u0648\u0633 (\u062f\u0633\u06a9\u062a\u0627\u067e) --- */\n.pi-footer .pi-f-cta-wrap{position:relative;background:var(--pi-page);border-bottom-right-radius:var(--pi-r);}\n.pi-footer .pi-f-cta-wrap::before,.pi-footer .pi-f-cta-wrap::after{content:\"\";position:absolute;width:var(--pi-r);height:var(--pi-r);pointer-events:none;\n  background:radial-gradient(circle at 100% 100%,transparent calc(var(--pi-r) - .5px),var(--pi-page) var(--pi-r));}\n.pi-footer .pi-f-cta-wrap::before{top:0;right:calc(var(--pi-r) * -1);}\n.pi-footer .pi-f-cta-wrap::after{top:100%;left:0;}\n.pi-footer .pi-f-cta{height:100%;position:relative;overflow:hidden;transition:transform .35s ease,box-shadow .35s ease;}\n.pi-footer .pi-f-cta:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(43,50,60,.12);}\n.pi-footer .pi-f-cta-text{flex:1 1 auto!important;min-width:0;}\n.pi-footer .pi-f-cta-art{flex:0 0 auto!important;width:auto!important;position:relative;}\n.pi-footer .pi-f-cta-art .elementor-icon{position:relative;z-index:1;box-shadow:0 14px 30px rgba(177,26,59,.35);}\n.pi-footer .pi-f-cta-art::before,.pi-footer .pi-f-cta-art::after{content:\"\";position:absolute;inset:-14px;border-radius:50%;border:1.5px dashed rgba(177,26,59,.25);animation:piSpin 22s linear infinite;}\n.pi-footer .pi-f-cta-art::after{inset:-30px;border-style:solid;border-color:rgba(177,26,59,.08);animation:none;}\n@keyframes piSpin{to{transform:rotate(360deg)}}\n\n/* --- \u0633\u062a\u0648\u0646\u200c\u0647\u0627\u06cc \u0644\u06cc\u0646\u06a9 --- */\n.pi-footer .pi-f-title .elementor-heading-title::after{content:\"\";display:block;width:26px;height:2px;margin-top:10px;border-radius:2px;background:var(--pi-red);transition:width .3s ease;}\n.pi-footer .pi-f-col:hover .pi-f-title .elementor-heading-title::after{width:44px;}\n.pi-footer .pi-f-list .elementor-icon-list-item a,.pi-footer .pi-f-list .elementor-icon-list-item>span{transition:transform .25s ease,color .25s ease;}\n.pi-footer .pi-f-list .elementor-icon-list-item:hover a{transform:translateX(-5px);}\n.pi-footer .pi-f-contact .elementor-icon-list-icon{width:34px;height:34px;flex:0 0 34px;display:inline-flex!important;align-items:center;justify-content:center;border-radius:10px;background:rgba(255,255,255,.06);}\n\n/* --- \u0628\u062e\u0634 \u067e\u0627\u06cc\u06cc\u0646 \u0628\u0627 \u0627\u0644\u06af\u0648\u06cc \u0634\u0634\u200c\u0636\u0644\u0639\u06cc --- */\n.pi-footer .pi-f-bottom{background-image:var(--pi-hex);background-size:56px 98px;border-top:1px solid var(--pi-line);}\n.pi-footer .pi-f-brand-head .pi-f-logo img{background:#fff;border-radius:16px;padding:6px;}\n.pi-footer .pi-f-badge p{display:inline-flex;align-items:center;gap:8px;margin:0;padding:8px 14px;border-radius:40px;background:rgba(255,255,255,.07);border:1px solid var(--pi-line);}\n.pi-footer .pi-f-badge-ic{display:inline-flex;width:20px;height:20px;align-items:center;justify-content:center;border-radius:50%;background:var(--pi-red);font-size:11px;}\n.pi-footer .pi-f-actions{align-items:stretch!important;}\n.pi-footer .pi-f-btns{flex:1 1 auto!important;min-width:0;}\n.pi-footer .pi-f-abtn .elementor-button{width:100%;justify-content:flex-start;transition:background-color .25s ease,transform .25s ease;}\n.pi-footer .pi-f-abtn .elementor-button-icon{display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;border-radius:9px;background:rgba(255,255,255,.08);}\n.pi-footer .pi-f-abtn .elementor-button:hover{transform:translateX(-4px);}\n.pi-footer .pi-f-tile{flex:0 0 118px!important;width:118px!important;transition:transform .3s ease,box-shadow .3s ease;}\n.pi-footer .pi-f-tile:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(177,26,59,.35);}\n.pi-footer .pi-f-tile .elementor-icon-box-title a::after{content:\"\";position:absolute;inset:0;}\n.pi-footer .pi-f-tile .elementor-icon{animation:piRing 2.8s ease-in-out infinite;}\n@keyframes piRing{0%,80%,100%{transform:rotate(0)}84%{transform:rotate(-14deg)}88%{transform:rotate(12deg)}92%{transform:rotate(-8deg)}96%{transform:rotate(5deg)}}\n.pi-footer .pi-f-tile .elementor-icon-box-description{direction:ltr;white-space:nowrap;font-size:11.5px!important;}\n\n/* --- \u0646\u0648\u0627\u0631 \u06a9\u067e\u06cc\u200c\u0631\u0627\u06cc\u062a --- */\n.pi-footer .pi-f-copy{position:relative;}\n.pi-footer .pi-f-copy::before{content:\"\";position:absolute;inset:0;background-image:var(--pi-hex);background-size:56px 98px;opacity:.9;pointer-events:none;}\n.pi-footer .pi-f-copy>*{position:relative;}\n.pi-footer .pi-f-copy p{margin:0;}\n.pi-totop{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;padding:0;border:0;border-radius:50%;background:#fff;color:var(--pi-red,#B11A3B);cursor:pointer;box-shadow:0 8px 20px rgba(0,0,0,.18);transition:transform .25s ease;}\n.pi-totop:hover{transform:translateY(-3px);}\n\n/* ================= \u0631\u06cc\u0633\u067e\u0627\u0646\u0633\u06cc\u0648 ================= */\n@media (max-width:1024px){\n  .pi-footer{--pi-r:22px;}\n  .pi-footer .pi-f-top{flex-direction:column!important;}\n  .pi-footer .pi-f-cta-wrap{order:-1;width:100%!important;background:transparent;border-radius:0;padding:16